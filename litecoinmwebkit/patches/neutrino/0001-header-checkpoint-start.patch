+// seedFromCheckpoint writes the checkpoint's headers at their real offsets in
+// the flat file (leaving the range between genesis and the first bundled
+// header unwritten) and indexes them, making the checkpoint height the chain
+// tip. The genesis header must already be written.
+func (h *blockHeaderStore) seedFromCheckpoint(netParams *chaincfg.Params,
+	checkpoint *Checkpoint) error {
 
+	if err := checkpoint.Validate(netParams.Net); err != nil {
+		return err
+	}
+
+	h.mtx.Lock()
+	defer h.mtx.Unlock()
+
+	startHeight := checkpoint.StartHeight()
+
+	headerBuf := headerBufPool.Get().(*bytes.Buffer)
+	headerBuf.Reset()
+	defer headerBufPool.Put(headerBuf)
+
+	entries := make(headerBatch, 0, len(checkpoint.Headers))
+	for i := range checkpoint.Headers {
+		header := &checkpoint.Headers[i]
+		if err := header.Serialize(headerBuf); err != nil {
+			return err
+		}
+		entries = append(entries, headerEntry{
+			hash:   header.BlockHash(),
+			height: startHeight + uint32(i),
+		})
+	}
+
+	offset := int64(startHeight) * BlockHeaderSize
+	if err := h.writeAt(headerBuf.Bytes(), offset); err != nil {
+		return err
+	}
+
+	if err := h.addHeaders(entries); err != nil {
+		return err
+	}
+	if err := h.putStartHeight(startHeight); err != nil {
+		return err
+	}
+	h.startHeight = startHeight
+
+	return nil
+}
