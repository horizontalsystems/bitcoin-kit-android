+
+// checkpointMagic identifies a serialized Checkpoint.
+var checkpointMagic = [4]byte{'N', 'C', 'K', 'P'}
+
+// checkpointVersion is the current serialization version of a Checkpoint.
+const checkpointVersion = 1
+
+// Checkpoint is a trusted snapshot of the header chain that lets a fresh
+// header store start syncing from a recent height instead of genesis. It
+// carries a contiguous run of block headers ending at Height (enough for the
+// contextual header checks: at least one retarget window), the regular
+// compact filter header at Height, and optionally the MWEB
+// leaves-at-height map for heights at or below Height.
+//
+// Headers below the first bundled height are never downloaded. The stores
+// keep the genesis header at height 0 and report ErrHeaderNotFound for any
+// height strictly between genesis and the first bundled height.
+type Checkpoint struct {
+	// Net is the network the checkpoint belongs to.
+	Net wire.BitcoinNet
+
+	// Height is the height of the last header in Headers.
+	Height uint32
+
+	// Headers are the block headers for heights
+	// Height-len(Headers)+1 .. Height, in ascending order.
+	Headers []wire.BlockHeader
+
+	// FilterHeader is the regular compact filter header at Height.
+	FilterHeader chainhash.Hash
+
+	// MwebLeaves maps block heights at or below Height to the MWEB output
+	// MMR size at that height. It may be empty.
+	MwebLeaves map[uint32]uint64
+}
+
+// StartHeight returns the height of the first bundled header.
+func (c *Checkpoint) StartHeight() uint32 {
+	return c.Height - uint32(len(c.Headers)) + 1
+}
+
+// Validate checks that the checkpoint is internally consistent and belongs to
+// the given network.
+func (c *Checkpoint) Validate(net wire.BitcoinNet) error {
+	if c.Net != net {
+		return fmt.Errorf("checkpoint is for network %v, want %v",
+			c.Net, net)
+	}
+	if len(c.Headers) == 0 {
+		return fmt.Errorf("checkpoint has no headers")
+	}
+	if uint32(len(c.Headers)) > c.Height {
+		return fmt.Errorf("checkpoint headers reach below genesis")
+	}
+	for i := 1; i < len(c.Headers); i++ {
+		prevHash := c.Headers[i-1].BlockHash()
+		if c.Headers[i].PrevBlock != prevHash {
+			return fmt.Errorf("checkpoint header %d does not "+
+				"connect to its parent", c.StartHeight()+uint32(i))
+		}
+	}
+	for height := range c.MwebLeaves {
+		if height > c.Height {
+			return fmt.Errorf("checkpoint mweb leaves entry at "+
+				"height %d above checkpoint height %d", height,
+				c.Height)
+		}
+	}
+	return nil
+}
+
+// WriteCheckpoint serializes the checkpoint to w.
+func WriteCheckpoint(w io.Writer, c *Checkpoint) error {
+	var buf bytes.Buffer
+	buf.Write(checkpointMagic[:])
+	binary.Write(&buf, binary.LittleEndian, uint32(checkpointVersion))
+	binary.Write(&buf, binary.LittleEndian, uint32(c.Net))
+	binary.Write(&buf, binary.LittleEndian, c.Height)
+	binary.Write(&buf, binary.LittleEndian, uint32(len(c.Headers)))
+	for i := range c.Headers {
+		if err := c.Headers[i].Serialize(&buf); err != nil {
+			return err
+		}
+	}
+	buf.Write(c.FilterHeader[:])
+	binary.Write(&buf, binary.LittleEndian, uint32(len(c.MwebLeaves)))
+	heights := make([]uint32, 0, len(c.MwebLeaves))
+	for height := range c.MwebLeaves {
+		heights = append(heights, height)
+	}
+	sortUint32(heights)
+	for _, height := range heights {
+		binary.Write(&buf, binary.LittleEndian, height)
+		binary.Write(&buf, binary.LittleEndian, c.MwebLeaves[height])
+	}
+	_, err := w.Write(buf.Bytes())
+	return err
+}
+
+// ReadCheckpoint deserializes a checkpoint from r.
+func ReadCheckpoint(r io.Reader) (*Checkpoint, error) {
+	var magic [4]byte
+	if _, err := io.ReadFull(r, magic[:]); err != nil {
+		return nil, err
+	}
+	if magic != checkpointMagic {
+		return nil, fmt.Errorf("not a header checkpoint file")
+	}
+	var version, net, height, numHeaders uint32
+	for _, v := range []*uint32{&version, &net, &height, &numHeaders} {
+		if err := binary.Read(r, binary.LittleEndian, v); err != nil {
+			return nil, err
+		}
+	}
+	if version != checkpointVersion {
+		return nil, fmt.Errorf("unsupported checkpoint version %d",
+			version)
+	}
+	if numHeaders == 0 || numHeaders > height {
+		return nil, fmt.Errorf("invalid checkpoint header count %d",
+			numHeaders)
+	}
+	c := &Checkpoint{
+		Net:        wire.BitcoinNet(net),
+		Height:     height,
+		Headers:    make([]wire.BlockHeader, numHeaders),
+		MwebLeaves: make(map[uint32]uint64),
+	}
+	for i := range c.Headers {
+		if err := c.Headers[i].Deserialize(r); err != nil {
+			return nil, err
+		}
+	}
+	if _, err := io.ReadFull(r, c.FilterHeader[:]); err != nil {
+		return nil, err
+	}
+	var numLeaves uint32
+	if err := binary.Read(r, binary.LittleEndian, &numLeaves); err != nil {
+		return nil, err
+	}
+	for i := uint32(0); i < numLeaves; i++ {
+		var h uint32
+		var n uint64
+		if err := binary.Read(r, binary.LittleEndian, &h); err != nil {
+			return nil, err
+		}
+		if err := binary.Read(r, binary.LittleEndian, &n); err != nil {
+			return nil, err
+		}
+		c.MwebLeaves[h] = n
+	}
+	return c, nil
+}
+
+// ReadCheckpointFile reads a checkpoint from the file at path.
+func ReadCheckpointFile(path string) (*Checkpoint, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	return ReadCheckpoint(f)
+}
+
+// sortUint32 sorts heights ascending (insertion sort keeps the package free
+// of extra imports; the slices are small).
+func sortUint32(s []uint32) {
+	for i := 1; i < len(s); i++ {
+		for j := i; j > 0 && s[j-1] > s[j]; j-- {
+			s[j-1], s[j] = s[j], s[j-1]
+		}
+	}
+}
+
+// writeAt writes data at the given offset of the store's flat file. The
+// store's own handle is opened in append mode, so a second handle is used.
+// The file grows sparsely when the offset lies beyond its current end.
+func (h *headerStore) writeAt(data []byte, offset int64) error {
+	f, err := os.OpenFile(h.fileName, os.O_RDWR, 0644)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	if _, err := f.WriteAt(data, offset); err != nil {
+		return err
+	}
+	return f.Sync()
+}
