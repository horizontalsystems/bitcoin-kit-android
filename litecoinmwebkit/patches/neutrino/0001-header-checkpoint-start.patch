+// startKey returns the key under which the seeded start height of this
+// index type is stored.
+func (h *headerIndex) startKey() ([]byte, error) {
+	switch h.indexType {
+	case Block:
+		return bitcoinStart, nil
+	case RegularFilter:
+		return regFilterStart, nil
+	default:
+		return nil, fmt.Errorf("unknown index type: %v", h.indexType)
+	}
+}
+
+// startHeight returns the seeded start height of the index, or 0 when the
+// store was synced from genesis.
+func (h *headerIndex) startHeight() (uint32, error) {
+	key, err := h.startKey()
+	if err != nil {
+		return 0, err
+	}
+	var height uint32
+	err = walletdb.View(h.db, func(tx walletdb.ReadTx) error {
+		rootBucket := tx.ReadBucket(indexBucket)
+		if v := rootBucket.Get(key); len(v) == 4 {
+			height = binary.BigEndian.Uint32(v)
+		}
+		return nil
+	})
+	return height, err
+}
+
+// putStartHeight records the seeded start height of the index.
+func (h *headerIndex) putStartHeight(height uint32) error {
+	key, err := h.startKey()
+	if err != nil {
+		return err
+	}
+	return walletdb.Update(h.db, func(tx walletdb.ReadWriteTx) error {
+		var heightBytes [4]byte
+		binary.BigEndian.PutUint32(heightBytes[:], height)
+		return tx.ReadWriteBucket(indexBucket).Put(key, heightBytes[:])
+	})
+}
